{
  "name": "dsh-tavily",
  "version": "0.3.2",
  "type": "module",
  "description": "Tavily web search for DSH: Plugins-page toggle back to official DeepSeek, keyless by default",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SZMY-haruhi/dsh-tavily.git"
  },
  "bugs": {
    "url": "https://github.com/SZMY-haruhi/dsh-tavily/issues"
  },
  "homepage": "https://github.com/SZMY-haruhi/dsh-tavily#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "tavily"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0 || >=4.0.5-alpha.0 <5.0.0",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <0.3.0 || >=0.2.1-alpha.0 <0.3.0"
  }
}
